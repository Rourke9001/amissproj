<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.rourke9001</groupId>
    <artifactId>amissproj</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>AmissProj</name>
    <description>Java Swing remake of "Jones in the Fast Lane", persisted in MySQL.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>8</maven.compiler.release>
        <main.class>amiss.presentation.ui.LoginGUI</main.class>

        <!-- Test toolchain (test scope only; runs on the JDK 20 runtime). -->
        <junit.version>5.10.2</junit.version>
        <mockito.version>5.11.0</mockito.version>
        <surefire.version>3.2.5</surefire.version>
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <!--
      AbsoluteLayout is a NetBeans Swing helper that is not published to Maven
      Central. We vendor our committed copy (vendor/AbsoluteLayout.jar) into a
      project-local Maven repository (vendor-repo/, populated via
      `mvn install:install-file ... -DlocalRepositoryPath=vendor-repo`) so the
      build stays reproducible and offline-capable without committing the jar
      onto the classpath by hand. project.baseUri yields a valid file:/// URL on
      Windows and *nix alike.
    -->
    <repositories>
        <repository>
            <id>project-vendor</id>
            <name>Project-local vendored jars</name>
            <url>${project.baseUri}vendor-repo</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <!--
      Align all JUnit 5 artifacts (jupiter API/engine, platform) on one version
      via the official BOM, so we never have to pin them individually.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- MySQL JDBC driver (Community build from Maven Central). -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.7.0</version>
        </dependency>

        <!-- Logging: SLF4J facade + Logback backend (Java 8 1.3.x line). -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.3.14</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
            <version>1.3.14</version>
        </dependency>

        <!-- BCrypt password hashing. -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

        <!-- Vendored NetBeans Swing layout helper (see <repositories> above). -->
        <dependency>
            <groupId>org.netbeans.lib</groupId>
            <artifactId>absolutelayout</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- ===== Test scope ===== -->
        <!-- JUnit 5 (Jupiter aggregator: API + params + engine), version from the BOM. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Mockito to mock the amiss.repository DAOs so the service rules are unit-tested
          in isolation from MySQL. mockito-junit-jupiter provides MockitoExtension.
        -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>AmissProj</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!--
              Pin Surefire 3.x so the JUnit 5 (JUnit Platform) engine is discovered
              and run. Maven 3.9.9's default is already 3.x, but we pin it explicitly
              so the test run is reproducible across Maven versions / CI.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
            </plugin>

            <!--
              JaCoCo line/branch coverage. prepare-agent wires the coverage agent into
              the Surefire JVM; the report goal (bound to test) writes
              target/site/jacoco/index.html after the tests run.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Package a single runnable uber-jar: target/AmissProj.jar.
              - ManifestResourceTransformer sets the Main-Class.
              - ServicesResourceTransformer MERGES META-INF/services so the
                SLF4J 2.x provider (logback) AND the JDBC java.sql.Driver are
                discovered from inside the shaded jar. Without it logging and/or
                the MySQL driver silently fail to load.
              - The filter strips dependency jar signatures (else the JVM rejects
                the repackaged jar) and module-info from multi-release jars.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
