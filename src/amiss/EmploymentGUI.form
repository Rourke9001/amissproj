      <SubComponents>
        <Component class="javax.swing.JTextArea" name="txaNotification">
          <Properties>
            <Property name="editable" type="boolean" value="false"/>
            <Property name="columns" type="int" value="20"/>
            <Property name="lineWrap" type="boolean" value="true"/>
            <Property name="rows" type="int" value="5"/>
            <Property name="text" type="java.lang.String" value="Welcome to the Employment Office. Here is where you will be able to select a Job and start earing money. &#xa;&#xa;Pick your Career wisely as takes 10 minutes everytime you select one.&#xa;&#xa;If you know you don&apos;t have qualification for a career don&apos;t try select it as it will say you dont have enough education. Once you complete a degree at University you will be told what jobs you can apply to.&#xa;&#xa;The safest option if you looking for you 1st job will be a Janitor. "/>
            <Property name="wrapStyleWord" type="boolean" value="true"/>
          </Properties>
        </Component>
      </SubComponents>
