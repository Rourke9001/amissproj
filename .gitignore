# ─── Maven build output (root and every module) ───
target/
# ─── VSCode Java language-server scratch output (invisible-project classes) ───
/build/
/bin/

# ─── Runtime logs (written by Logback's file appender) ───
/logs/

# ─── Frontend (React SPA in frontend/, KAN-38) ───
node_modules/
frontend/dist/

# Note: third-party dependencies are now managed by Maven (see pom.xml) and are
# NOT committed. The sole exception is vendor/AbsoluteLayout.jar (not on Maven
# Central), installed into the committed project-local repo vendor-repo/ — both
# are tracked on purpose so the build is reproducible offline and in CI.

# ─── Secrets (none today, but never commit these) ───
*.env
secrets.properties

# ─── IDE / editor / OS cruft ───
.idea/
# Ignore per-user VSCode state, but track shared project config (recommendations).
.vscode/*
!.vscode/extensions.json
*.iml
Thumbs.db
.DS_Store
