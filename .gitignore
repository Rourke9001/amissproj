# ─── Build output & packaged artifact (regenerated by scripts\build.ps1) ───
/build/
/dist/AmissProj.jar

# ─── Runtime logs (written by Logback's file appender) ───
/logs/

# The jars in dist/lib/ ARE committed on purpose so the project is clone-and-run.
# All are freely redistributable:
#   AbsoluteLayout.jar       - NetBeans, CDDL/GPLv2+CPE
#   beansbinding-1.2.1.jar   - LGPL/BSD
#   mysql-connector-j-*.jar  - GPLv2 + FOSS exception (Community build from Maven Central)
#   slf4j-api-*.jar          - MIT
#   logback-core/classic-*.jar - EPL-1.0 / LGPL-2.1 (dual)
#   jbcrypt-*.jar            - ISC-style BSD

# ─── NetBeans per-user state (machine-specific, not portable) ───
/nbproject/private/

# ─── Secrets (none today, but never commit these) ───
*.env
secrets.properties

# ─── IDE / editor / OS cruft ───
.idea/
# Ignore per-user VSCode state, but track shared project config (classpath, recos).
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.iml
Thumbs.db
.DS_Store
