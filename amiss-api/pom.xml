<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.rourke9001</groupId>
        <artifactId>amissproj</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>amiss-api</artifactId>
    <packaging>jar</packaging>

    <name>AmissProj :: REST API</name>
    <description>Spring Boot REST API over the amiss-core game services — a second
        presentation adapter alongside the Swing client (ROADMAP Phase 3 / KAN-16).</description>

    <properties>
        <spring-boot.version>3.5.16</spring-boot.version>
    </properties>

    <!--
      The Spring Boot BOM is imported in THIS module only: core and swing must
      never have their dependency versions managed by Boot.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The game itself: rules, ports, JDBC adapters, Flyway migrations. -->
        <dependency>
            <groupId>io.github.rourke9001</groupId>
            <artifactId>amiss-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Hikari DataSource auto-config; Jdbc borrows pooled connections from it. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Repackages the jar in Boot's executable nested-jar layout. Lives in
              this module only — never alongside maven-shade (amiss-swing), which
              uses a flat merged layout instead.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
