<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.rourke9001</groupId>
        <artifactId>amissproj</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>amiss-api</artifactId>
    <packaging>jar</packaging>

    <name>AmissProj :: REST API</name>
    <description>Spring Boot REST API over the amiss-core game services — a second
        presentation adapter alongside the Swing client (ROADMAP Phase 3 / KAN-16).</description>

    <properties>
        <spring-boot.version>3.5.16</spring-boot.version>
    </properties>

    <!--
      The Spring Boot BOM is imported in THIS module only: core and swing must
      never have their dependency versions managed by Boot.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The game itself: rules, ports, JDBC adapters, Flyway migrations. -->
        <dependency>
            <groupId>io.github.rourke9001</groupId>
            <artifactId>amiss-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Hikari DataSource auto-config; Jdbc borrows pooled connections from it. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!--
          JPA entity layer over the Flyway-owned schema (KAN-33). ddl-auto is
          validate-only: Flyway remains the sole schema owner. No Spring Data
          repositories yet — the game still runs on the JDBC adapters wired in
          PersistenceConfig; that swap is a later PR (KAN-17/KAN-34).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Testcontainers MySQL integration tests (KAN-35): the *IT.java suites in
          amiss.api.persistence.jpa run the four JPA port adapters against a real,
          freshly-Flyway-migrated MySQL container instead of mocks. Versions come from
          the Boot BOM (spring-boot-dependencies manages the Testcontainers BOM too).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Repackages the jar in Boot's executable nested-jar layout. Lives in
              this module only — never alongside maven-shade (amiss-swing), which
              uses a flat merged layout instead.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              Runs the *IT.java Testcontainers suites in integration-test, then fails the
              build in verify if any failed (KAN-35). Surefire (bound in the parent) only
              ever sees *Test classes, so `mvnw test` — and even `mvnw package`, which stops
              before integration-test — stays Docker-free; only `mvnw verify` reaches these.

              classesDirectory is pinned explicitly: `package` (spring-boot:repackage, right
              above) runs before `integration-test` and replaces this module's own jar with
              Boot's exploded nested-jar layout (classes under BOOT-INF/classes/, not the
              jar root). Without this override Failsafe puts that repackaged jar on the IT
              classpath instead of the plain target/classes Surefire uses, and every one of
              this module's own classes (entities, adapters, AmissApiApplication) fails to
              load — surfaced as NoClassDefFoundError / "no @SpringBootConfiguration found".
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
