# Deliberately near-empty. Testcontainers' MySQLContainer always mounts a bundled
# my.cnf into /etc/mysql/conf.d (mysql-default-conf, baked into the org.testcontainers:mysql
# jar) unless withConfigurationOverride(...) points at a classpath directory of our own
# (KAN-35). That bundled file sets legacy tuning knobs from the MySQL 5.x/8.0 era, including
# innodb_log_file_size — a startup variable MySQL 9 removed outright (superseded by
# innodb_redo_log_capacity). Against mysql:9 the container fails hard at boot:
# "[ERROR] unknown variable 'innodb_log_file_size=5M'".
#
# MySqlITSupport points withConfigurationOverride at this directory instead, which
# neutralizes the bundled file (MySQL falls back to its own compiled-in defaults — plenty
# for one disposable per-test-class container) without patching anything under src/main.
[mysqld]
