<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.rourke9001</groupId>
        <artifactId>amissproj</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>amiss-swing</artifactId>
    <packaging>jar</packaging>

    <name>AmissProj :: swing client</name>
    <description>The original Swing desktop client over amiss-core; builds the
        shaded runnable AmissProj.jar (entry point amiss.presentation.ui.LoginGUI).</description>

    <properties>
        <main.class>amiss.presentation.ui.LoginGUI</main.class>
    </properties>

    <!--
      AbsoluteLayout is a NetBeans Swing helper that is not published to Maven
      Central. We vendor our committed copy (vendor/AbsoluteLayout.jar) into a
      project-local Maven repository (vendor-repo/ at the REPO root, populated via
      `mvn install:install-file ... -DlocalRepositoryPath=vendor-repo`) so the
      build stays reproducible and offline-capable. project.baseUri resolves
      per-MODULE, hence the ../ to reach the root. It yields a valid file:///
      URL on Windows and *nix alike.
    -->
    <repositories>
        <repository>
            <id>project-vendor</id>
            <name>Project-local vendored jars</name>
            <url>${project.baseUri}../vendor-repo</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <dependencies>
        <!-- The game itself: rules, ports, JDBC adapters, migrations. -->
        <dependency>
            <groupId>io.github.rourke9001</groupId>
            <artifactId>amiss-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Vendored NetBeans Swing layout helper (see <repositories> above). -->
        <dependency>
            <groupId>org.netbeans.lib</groupId>
            <artifactId>absolutelayout</artifactId>
        </dependency>

        <!--
          Logback is this app's SLF4J backend (configured by logback.xml in this
          module's resources). Runtime scope: no code here calls logback classes.
        -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>AmissProj</finalName>
        <plugins>
            <!--
              Package a single runnable uber-jar: amiss-swing/target/AmissProj.jar.
              - ManifestResourceTransformer sets the Main-Class.
              - ServicesResourceTransformer MERGES META-INF/services so the
                SLF4J 2.x provider (logback) AND the JDBC java.sql.Driver are
                discovered from inside the shaded jar. Without it logging and/or
                the MySQL driver silently fail to load.
              - The filter strips dependency jar signatures (else the JVM rejects
                the repackaged jar) and module-info from multi-release jars.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
